function _ayu_restore_previous_theme
	set --universal fish_color_autosuggestion brblack --theme=default
	set --universal fish_color_cancel -r --theme=default
	set --universal fish_color_command --reset --theme=default
	set --universal fish_color_comment red --theme=default
	set --universal fish_color_cwd green --theme=default
	set --universal fish_color_cwd_root red --theme=default
	set --universal fish_color_end green --theme=default
	set --universal fish_color_error brred --theme=default
	set --universal fish_color_escape brcyan --theme=default
	set --universal fish_color_history_current --bold --theme=default
	set --universal fish_color_host --reset --theme=default
	set --universal fish_color_host_remote yellow --theme=default
	set --universal fish_color_normal --reset --theme=default
	set --universal fish_color_operator brcyan --theme=default
	set --universal fish_color_param cyan --theme=default
	set --universal fish_color_quote yellow --theme=default
	set --universal fish_color_redirection cyan --bold --theme=default
	set --universal fish_color_search_match white --background=brblack --bold --theme=default
	set --universal fish_color_selection white --background=brblack --bold --theme=default
	set --universal fish_color_status red --theme=default
	set --universal fish_color_user brgreen --theme=default
	set --universal fish_color_valid_path --underline --theme=default
end
